UPLOAD_LOCATION=

# S3/R2 -----------------------------------------------------------------------
# Reference https://docs.aws.amazon.com/sdkref/latest/guide/environment-variables.html for more information
AWS_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com  # Optional, omit to use AWS S3 instead of Cloudflare R2
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_SESSION_TOKEN=  # Optional
AWS_REGION=auto
AWS_BUCKET_NAME=my-immich-backup

# Backup ----------------------------------------------------------------------
BACKUP_ZIP_PASSWORD=hunter2
BACKUP_HISTORY_FILE=./backup-history.sqlite
BACKUP_INTERVAL_DAYS=7  # Only used with --forever

BACKUP_BATCH_SIZE_BYTES=10737418240
BACKUP_MULTIPART_CHUNK_SIZE=67110000

BACKUP_FILE_UPLOAD_CONCURRENCY=1
BACKUP_FILE_CHUNK_UPLOAD_CONCURRENCY=3

BACKUP_MAX_UPLOAD_RETRIES=10
BACKUP_MAX_UPLOAD_RETRY_BACKOFF=30
