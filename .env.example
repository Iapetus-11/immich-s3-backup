# Immich ----------------------------------------------------------------------
# These should likely match Immich's ENVs
DB_HOSTNAME=database
DB_USERNAME=postgres
DB_PASSWORD=
UPLOAD_LOCATION=

# S3/R2 -----------------------------------------------------------------------
# Reference https://docs.aws.amazon.com/sdkref/latest/guide/environment-variables.html for more information
AWS_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com  # Optional, omit to use AWS S3 instead of Cloudflare R2
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_SESSION_TOKEN=  # Optional
AWS_REGION=auto

# Backup ----------------------------------------------------------------------
BACKUP_ARCHIVE_PASSWORD=
BACKUP_HISTORY_FILE_PATH=./backup-history.sqlite
BACKUP_UPLOAD_BUCKET_NAME=my-immich-backup
BACKUP_INTERVAL_DAYS=7  # Only used with --forever

BACKUP_BATCH_MAX_SIZE_BYTES=10737418240
BACKUP_UPLOAD_CHUNK_SIZE_BYTES=67108864

BACKUP_UPLOAD_FILE_CONCURRENCY=1
BACKUP_UPLOAD_CHUNK_CONCURRENCY=3

BACKUP_DATABASE_DUMP_TIMEOUT_SECONDS=1200
BACKUP_UPLOAD_TIMEOUT_SECONDS=300
BACKUP_UPLOAD_MAX_RETRIES=10
